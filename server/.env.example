PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/audix_store
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
# Prefer using ADMIN_PASSWORD_HASH. Example generation:
# node -e "console.log(require('bcryptjs').hashSync('ChangeMe123!', 10))"
ADMIN_PASSWORD_HASH=
# Comma-separated allowed origins for frontend, e.g. https://audix.vercel.app
CORS_ORIGIN=
